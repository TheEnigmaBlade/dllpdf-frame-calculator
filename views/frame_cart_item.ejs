<div class="frame-cart-item row" data-id="<%= item.id %>" data-specs="<%= data %>">
  <span class="col col-0 item-controls">
    <button class="cart-item-button delete-button"><img src="trash.svg" alt="Delete" width="18" height="18"/></button> 
    <button class="cart-item-button edit-button"><img src="pencil.svg" alt="Edit" width="18" height="18"/></button>
  </span> 
  <span class="col col-1 item-name"><input class="name-input" type="text" value="<%= item.name %>" /></span>
  <span class="col col-2 item-type"><%= item.type %></span>
  <span class="col col-3 item-length"><%= item.length %> mm</span>
  <span class="col col-4 item-holes">
    <span class="value"><%= item.holeCount %></span>
    <div class="item-holes-dialog"></div>
  </span>
  <span class="col col-5 item-unit-cost"></span>
  <span class="col col-6 item-quantity"><input class="quantity-input" type="number" min="1" max="99" value="<%= item.quantity %>"/></span>
  <span class="col col-7 item-total-cost"></span>
</div>
